# Video generation provider: pixverse | seedance
VIDEO_PROVIDER=pixverse

# PixVerse API
PIXVERSE_API_KEY=your-pixverse-api-key
PIXVERSE_MODEL=v4.5
PIXVERSE_QUALITY=540p
PIXVERSE_MOTION_MODE=normal
PIXVERSE_DURATION=5

# Volcengine Ark LLM API
VOLC_API_KEY=your-volcengine-api-key

# Seedance model configuration
SEEDANCE_MODEL=doubao-seedance-1-5-pro-251215
VIDEO_DURATION=5
VIDEO_RESOLUTION=720p
VIDEO_ASPECT=16:9

# Seedance video API
ARK_API_KEY=your-video-api-key
ARK_BASE_URL=https://www.moyu.cn
ARK_VIDEO_MODEL=doubao-seedance-2-0-mini-260615

# Optional explicit variable names used by run_complete_pipeline.py
ARK_LLM_API_KEY=your-llm-api-key
ARK_VIDEO_API_KEY=your-video-api-key
AUDIO_API_KEY=your-audio-api-key
TTS_API_KEY=your-audio-api-key
